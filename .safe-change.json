{
  "version": 1,
  "checks": [
    {
      "name": "build",
      "executable": "npm",
      "args": [
        "run",
        "build"
      ],
      "timeout": 60
    },
    {
      "name": "test",
      "executable": "npx",
      "args": [
        "vitest",
        "run"
      ],
      "timeout": 120
    },
    {
      "name": "coverage",
      "executable": "npm",
      "args": [
        "run",
        "test:coverage"
      ],
      "timeout": 180
    },
    {
      "name": "dependency-audit",
      "executable": "npm",
      "args": [
        "audit",
        "--audit-level=high"
      ],
      "timeout": 120
    }
  ],
  "enterprisePolicy": {
    "policyVersion": 1,
    "minimumMode": "high-assurance",
    "requireBaseline": true,
    "requireTests": true,
    "requireCoverage": true,
    "requireDependencyAudit": true,
    "requireDiffReview": true,
    "allowForcePush": false,
    "allowDestructiveGit": false,
    "changeBudget": {
      "maxFilesChanged": 60,
      "maxLinesAdded": 5000,
      "maxLinesDeleted": 500,
      "maxPublicApisChanged": 30,
      "maxDeletedFiles": 0,
      "allowLockfileChanges": false
    }
  },
  "enforcementPolicy": {
    "policyVersion": 1,
    "defaultDecision": "deny",
    "requireSignedPolicy": false,
    "agents": [
      {
        "agent": "codex",
        "allow": [
          "repository:read",
          "source:write",
          "tests:execute",
          "dependency:modify",
          "ci:modify",
          "git:commit",
          "git:push",
          "release:publish",
          "policy:modify"
        ],
        "deny": [
          "secret:read"
        ],
        "resourcePatterns": [
          "**"
        ],
        "expiresAt": null
      }
    ],
    "commandSandbox": {
      "allowedExecutables": [
        "node",
        "npm",
        "npx"
      ],
      "deniedArguments": [
        "--force",
        "--force-with-lease",
        "--hard",
        "--no-verify"
      ],
      "allowedEnvironment": [
        "PATH",
        "HOME",
        "USERPROFILE",
        "TMPDIR",
        "TEMP",
        "TMP",
        "SystemRoot",
        "COMSPEC",
        "PATHEXT",
        "APPDATA",
        "LOCALAPPDATA",
        "NPM_CONFIG_CACHE",
        "NODE_OPTIONS",
        "CI"
      ],
      "inheritEnvironment": false,
      "networkPolicy": "inherit",
      "maxOutputBytes": 102400
    },
    "approvals": {
      "thresholds": {
        "dependency:modify": 1,
        "ci:modify": 1,
        "release:publish": 2,
        "policy:modify": 2
      },
      "prohibitSelfApproval": true,
      "requireSignedApprovals": true,
      "maximumExceptionTtlSeconds": 3600
    }
  },
  "policySignature": {
    "algorithm": "ed25519",
    "keyId": "safe-change-core-lead",
    "publicKeyPem": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAeo7qL4ylxDA3RTofMSM/SssK1B4DzWL2/AKM8T67CPE=\n-----END PUBLIC KEY-----\n",
    "policyDigest": "sha256:440f205781504acf1f14aee16b2457cdfaf88ff399fac96e4548a39dfb779bca",
    "signatureBase64": "Gw4uFN9ucAnvGO7DBGwM5y4f8xN//LwZZGIYD4EJ17GvjVVL+7++zzhTukXIAk6JdF5Enrx/BC/vwHKj6i4XCg=="
  }
}
