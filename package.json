{
  "name": "safe-change",
  "version": "1.1.0-preview.1",
  "description": "A local-first safety net for AI-assisted coding. Records baselines, detects regressions, and helps investigate changes without silently altering your work.",
  "type": "module",
  "bin": {
    "safe-change": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackpratamaa/safe-change.git"
  },
  "bugs": {
    "url": "https://github.com/zackpratamaa/safe-change/issues"
  },
  "homepage": "https://github.com/zackpratamaa/safe-change#readme",
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "LICENSE_CHANGE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:native": "sh scripts/build-native.sh",
    "build:native:win": "powershell scripts/build-native.ps1",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release:validate": "node scripts/validate-release.mjs",
    "release:preflight": "node scripts/preflight-npm.mjs",
    "release:dry-run": "node scripts/publish-orchestrator.mjs --dry-run"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "safety",
    "baseline",
    "regression",
    "git",
    "cli",
    "vibe-coding",
    "cursor",
    "claude-code",
    "codex",
    "antigravity",
    "developer-tools",
    "safe-change",
    "agpl-3-0",
    "typescript"
  ],
  "author": "ZACK.PRATAMA PT ZYNTRIX ARTIFICIAL INTELLIGENCE INDONESIA (SAFE-CHANGE)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@safe-change/darwin-arm64": "1.1.0-preview.1",
    "@safe-change/darwin-x64": "1.1.0-preview.1",
    "@safe-change/linux-x64-gnu": "1.1.0-preview.1",
    "@safe-change/win32-x64-msvc": "1.1.0-preview.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^6.4.3",
    "esbuild": "^0.25.0"
  }
}
