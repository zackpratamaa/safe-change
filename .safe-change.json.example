{
  "version": 1,
  "checks": [
    {
      "name": "build",
      "executable": "npm",
      "args": ["run", "build"],
      "timeout": 60
    },
    {
      "name": "test",
      "executable": "npx",
      "args": ["vitest", "run"],
      "timeout": 120
    },
    {
      "name": "coverage",
      "executable": "npm",
      "args": ["run", "test:coverage"],
      "timeout": 180
    },
    {
      "name": "dependency-audit",
      "executable": "npm",
      "args": ["audit", "--audit-level=high"],
      "timeout": 120
    }
  ],
  "enterprisePolicy": {
    "policyVersion": 1,
    "minimumMode": "standard",
    "requireBaseline": true,
    "requireTests": true,
    "requireCoverage": false,
    "requireDependencyAudit": false,
    "requireDiffReview": true,
    "allowForcePush": false,
    "allowDestructiveGit": false,
    "changeBudget": {
      "maxFilesChanged": 12,
      "maxLinesAdded": 500,
      "maxLinesDeleted": 200,
      "maxPublicApisChanged": 0,
      "maxDeletedFiles": 0,
      "allowLockfileChanges": false
    }
  },
  "enforcementPolicy": {
    "policyVersion": 1,
    "defaultDecision": "deny",
    "requireSignedPolicy": false,
    "agents": [
      {
        "agent": "*",
        "allow": ["repository:read", "source:write", "tests:execute"],
        "deny": ["secret:read", "release:publish", "policy:modify"],
        "resourcePatterns": ["src/**", "tests/**", "docs/**"],
        "expiresAt": null
      }
    ],
    "commandSandbox": {
      "allowedExecutables": ["node", "npm", "npx"],
      "deniedArguments": [
        "--force",
        "--force-with-lease",
        "--hard",
        "--no-verify"
      ],
      "allowedEnvironment": [
        "PATH",
        "HOME",
        "USERPROFILE",
        "TMPDIR",
        "TEMP",
        "TMP",
        "SystemRoot",
        "COMSPEC",
        "PATHEXT",
        "CI"
      ],
      "inheritEnvironment": false,
      "networkPolicy": "inherit",
      "maxOutputBytes": 102400
    },
    "approvals": {
      "thresholds": {
        "dependency:modify": 1,
        "ci:modify": 1,
        "release:publish": 2,
        "policy:modify": 2
      },
      "prohibitSelfApproval": true,
      "requireSignedApprovals": true,
      "maximumExceptionTtlSeconds": 3600
    }
  }
}
